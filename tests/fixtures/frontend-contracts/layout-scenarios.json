{
  "version": 1,
  "status": "synthetic-policy-inputs-not-production-layouts",
  "supportedLanguages": ["csharp", "typescript", "javascript", "sql", "config"],
  "supportedCapabilities": ["declarations", "references", "source-spans", "workspace-links"],
  "defaults": { "includeTests": "exclude", "generatedAndVendor": "exclude", "nestedRepositories": "stop" },
  "positive": [
    {
      "id": "root-project",
      "budgets": { "maxDepth": 8, "maxCandidates": 4, "maxFiles": 12, "maxBytes": 2048 },
      "entries": [
        { "path": "App.csproj", "kind": "marker", "bytes": 120 },
        { "path": "Program.cs", "kind": "source", "bytes": 100 },
        { "path": "tests/AppTests.cs", "kind": "test", "bytes": 80 },
        { "path": "obj/Generated.cs", "kind": "generated", "bytes": 75 }
      ],
      "units": [
        { "root": ".", "markerPath": "App.csproj", "id": "app", "language": "csharp", "capabilities": ["declarations", "references"], "includePatterns": ["**/*.cs"], "references": [] }
      ]
    },
    {
      "id": "nested-project",
      "budgets": { "maxDepth": 8, "maxCandidates": 4, "maxFiles": 12, "maxBytes": 2048 },
      "entries": [
        { "path": "Root.csproj", "kind": "marker", "bytes": 120 },
        { "path": "src/App.cs", "kind": "source", "bytes": 100 },
        { "path": "src/Api/Api.csproj", "kind": "marker", "bytes": 110 },
        { "path": "src/Api/Program.cs", "kind": "source", "bytes": 90 }
      ],
      "units": [
        { "root": ".", "markerPath": "Root.csproj", "id": "root", "language": "csharp", "capabilities": ["declarations"], "includePatterns": ["src/**/*.cs"], "references": [] },
        { "root": "src/Api", "markerPath": "src/Api/Api.csproj", "id": "api", "language": "csharp", "capabilities": ["declarations"], "includePatterns": ["**/*.cs"], "references": [] }
      ]
    },
    {
      "id": "mixed-language-monorepo",
      "budgets": { "maxDepth": 8, "maxCandidates": 5, "maxFiles": 15, "maxBytes": 4096 },
      "entries": [
        { "path": "api/Api.csproj", "kind": "marker", "bytes": 130 },
        { "path": "api/Program.cs", "kind": "source", "bytes": 100 },
        { "path": "web/tsconfig.json", "kind": "marker", "bytes": 160 },
        { "path": "web/src/index.ts", "kind": "source", "bytes": 110 },
        { "path": "ops/sql-profile.json", "kind": "marker", "bytes": 80 },
        { "path": "ops/select.sql", "kind": "source", "bytes": 95 }

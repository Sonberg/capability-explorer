    },
    {
      "id": "standalone-source",
      "budgets": { "maxDepth": 8, "maxCandidates": 4, "maxFiles": 8, "maxBytes": 1024 },
      "entries": [{ "path": "tools/run.js", "kind": "source", "bytes": 100 }],
      "units": []
    },
    {
      "id": "overlap-dedupe",
      "budgets": { "maxDepth": 8, "maxCandidates": 4, "maxFiles": 10, "maxBytes": 2048 },
      "entries": [
        { "path": "web/tsconfig.json", "kind": "marker", "bytes": 120 },
        { "path": "web/src/app.ts", "kind": "source", "bytes": 100 },
        { "path": "web/src/util.ts", "kind": "source", "bytes": 80 }
      ],
      "units": [
        { "root": "web", "markerPath": "web/tsconfig.json", "id": "web", "language": "typescript", "capabilities": ["declarations"], "includePatterns": ["src/**/*.ts", "src/app.ts"], "references": [] }
      ]
    },
    {
      "id": "missing-dependency",
      "budgets": { "maxDepth": 8, "maxCandidates": 4, "maxFiles": 10, "maxBytes": 2048 },
      "entries": [
        { "path": "app/App.csproj", "kind": "marker", "bytes": 130 },
        { "path": "app/Program.cs", "kind": "source", "bytes": 100 }
      ],
      "units": [
        { "root": "app", "markerPath": "app/App.csproj", "id": "app", "language": "csharp", "capabilities": ["declarations", "references"], "includePatterns": ["**/*.cs"], "references": [{ "target": "shared#core", "relation": "project" }] }
      ]
    },
    {
      "id": "nested-repository-boundary",
      "budgets": { "maxDepth": 8, "maxCandidates": 4, "maxFiles": 10, "maxBytes": 2048 },
      "entries": [
        { "path": "Root.csproj", "kind": "marker", "bytes": 120 },
        { "path": "Program.cs", "kind": "source", "bytes": 100 },
        { "path": "vendor/child/.git", "kind": "nested-repository", "bytes": 0 },
        { "path": "vendor/child/Child.csproj", "kind": "marker", "bytes": 120 },
        { "path": "vendor/child/Child.cs", "kind": "source", "bytes": 90 }
      ],
      "units": [
        { "root": ".", "markerPath": "Root.csproj", "id": "root", "language": "csharp", "capabilities": ["declarations"], "includePatterns": ["**/*.cs"], "references": [] }
      ]
    }
  ],
  "negative": [
    {
      "id": "unknown-language",
      "budgets": { "maxDepth": 4, "maxCandidates": 4, "maxFiles": 8, "maxBytes": 1024 },
      "entries": [{ "path": "src/file.x", "kind": "source", "bytes": 20 }],
      "units": [{ "root": ".", "markerPath": "unit.json", "id": "new", "language": "new-language-not-selected", "capabilities": [], "includePatterns": ["**/*"], "references": [] }]
    },
    {
      "id": "unknown-capability",
      "budgets": { "maxDepth": 4, "maxCandidates": 4, "maxFiles": 8, "maxBytes": 1024 },
      "entries": [{ "path": "src/file.ts", "kind": "source", "bytes": 20 }],
      "units": [{ "root": ".", "markerPath": "tsconfig.json", "id": "web", "language": "typescript", "capabilities": ["semantic.magic"], "includePatterns": ["**/*.ts"], "references": [] }]
    },
    {
      "id": "marker-free-ambiguity",
      "budgets": { "maxDepth": 4, "maxCandidates": 4, "maxFiles": 8, "maxBytes": 1024 },
      "entries": [{ "path": "src/file.ts", "kind": "source", "bytes": 20 }],
      "units": []
    },
    {
      "id": "conflicting-owner",
      "budgets": { "maxDepth": 4, "maxCandidates": 4, "maxFiles": 8, "maxBytes": 1024 },
      "entries": [{ "path": "src/shared.ts", "kind": "source", "bytes": 20 }],
      "units": [
        { "root": "src", "markerPath": "src/a.json", "id": "a", "language": "typescript", "capabilities": ["declarations"], "includePatterns": ["shared.ts"], "references": [] },
        { "root": "src", "markerPath": "src/b.json", "id": "b", "language": "typescript", "capabilities": ["declarations"], "includePatterns": ["shared.ts"], "references": [] }
      ]
    },
    {
      "id": "conflicting-override",
      "budgets": { "maxDepth": 4, "maxCandidates": 4, "maxFiles": 8, "maxBytes": 1024 },
      "entries": [{ "path": "app/main.ts", "kind": "source", "bytes": 20 }],
      "units": [
        { "root": "app", "markerPath": "app/tsconfig.json", "id": "app", "language": "typescript", "capabilities": ["declarations"], "includePatterns": ["main.ts"], "references": [] },
        { "root": "app", "markerPath": "app/ce-unit.json", "id": "app", "language": "javascript", "capabilities": ["declarations"], "includePatterns": ["main.ts"], "references": [] }
      ]
    },
    {
      "id": "budget-exceeded",
      "budgets": { "maxDepth": 1, "maxCandidates": 2, "maxFiles": 8, "maxBytes": 1024 },
      "entries": [
        { "path": "unit.json", "kind": "marker", "bytes": 5 },
        { "path": "src/deep/a.ts", "kind": "source", "bytes": 8 },
        { "path": "src/b.ts", "kind": "source", "bytes": 8 }
      ],
      "units": [{ "root": ".", "markerPath": "unit.json", "id": "web", "language": "typescript", "capabilities": ["declarations"], "includePatterns": ["**/*.ts"], "references": [] }]
    },
    {
      "id": "path-traversal",
      "budgets": { "maxDepth": 4, "maxCandidates": 4, "maxFiles": 8, "maxBytes": 1024 },
      "entries": [{ "path": "../escape.ts", "kind": "source", "bytes": 20 }],
      "units": [{ "root": ".", "markerPath": "unit.json", "id": "web", "language": "typescript", "capabilities": ["declarations"], "includePatterns": ["**/*.ts"], "references": [] }]
    },
    {
      "id": "symlink-escape",
      "budgets": { "maxDepth": 4, "maxCandidates": 4, "maxFiles": 8, "maxBytes": 1024 },
      "entries": [{ "path": "src/outside.ts", "kind": "symlink", "target": "../../outside.ts", "bytes": 0 }],
      "units": [{ "root": ".", "markerPath": "unit.json", "id": "web", "language": "typescript", "capabilities": ["declarations"], "includePatterns": ["**/*.ts"], "references": [] }]
    }
  ]

      "units": [
        { "root": "api", "markerPath": "api/Api.csproj", "id": "api", "language": "csharp", "capabilities": ["declarations"], "includePatterns": ["**/*.cs"], "references": [] },
        { "root": "web", "markerPath": "web/tsconfig.json", "id": "web", "language": "typescript", "capabilities": ["declarations", "references", "source-spans"], "includePatterns": ["**/*.ts"], "references": [] },
        { "root": "ops", "markerPath": "ops/sql-profile.json", "id": "queries", "language": "sql", "capabilities": ["declarations"], "includePatterns": ["**/*.sql"], "references": [] }
      ]
    },
    {
      "id": "multiple-markers",
      "budgets": { "maxDepth": 8, "maxCandidates": 4, "maxFiles": 10, "maxBytes": 2048 },
      "entries": [
        { "path": "web/package.json", "kind": "marker", "bytes": 120 },
        { "path": "web/tsconfig.json", "kind": "marker", "bytes": 150 },
        { "path": "web/src/app.ts", "kind": "source", "bytes": 100 },
        { "path": "web/src/legacy.js", "kind": "source", "bytes": 90 }

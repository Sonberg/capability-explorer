{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capability-explorer/schema/models/process-landscape.v1.schema.json",
  "title": "Capability Explorer local process-landscape snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "snapshotId", "manifestVersion", "repositoryId", "contentProfile",
    "coverage", "diagnostics", "sources", "processes", "searchIndex",
    "crossProcessEvents", "objectLifecycle", "phaseJourney", "overlays"
  ],
  "properties": {
    "schema": { "const": "ce.process-landscape.v1" },
    "snapshotId": { "type": "string", "pattern": "^landscape:[a-f0-9]{64}$" },
    "manifestVersion": { "const": 1 },
    "repositoryId": { "type": "string", "minLength": 1 },
    "contentProfile": { "enum": ["structural", "model-content"] },
    "coverage": { "$ref": "#/$defs/coverage" },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "processes": { "type": "array", "items": { "$ref": "#/$defs/process" } },
    "searchIndex": { "type": "array", "items": { "$ref": "#/$defs/searchEntry" } },
    "crossProcessEvents": { "type": "array", "items": { "$ref": "#/$defs/crossProcessEvent" } },
    "objectLifecycle": { "type": "array", "items": { "$ref": "#/$defs/objectLifecycle" } },
    "phaseJourney": { "type": "array", "items": { "$ref": "#/$defs/phaseJourneyPhase" } },
    "navigator": { "$ref": "#/$defs/navigator" },
    "documents": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/document" } },
    "overlays": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "phase"],
      "properties": {
        "context": { "type": "array", "items": { "$ref": "#/$defs/overlayEntry" } },
        "phase": { "type": "array", "items": { "$ref": "#/$defs/overlayEntry" } }
      }
    }
  },
  "if": {
    "properties": { "contentProfile": { "const": "structural" } },
    "required": ["contentProfile"]
  },
  "then": {
    "properties": {
      "sources": {
        "type": "array",
        "items": { "not": { "type": "object", "required": ["sourceBytesBase64"] } }
      }
    }
  },
  "$defs": {
    "document": {
      "description": "Opt-in canonical multi-process document graph. Path joins sources; semantic process ownership is unchanged. Document parents/endpoints resolve only in this document and processes sharing its path.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "elements", "relationships"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "elements": { "type": "array", "maxItems": 25000, "items": { "$ref": "#/$defs/element" } },
        "relationships": { "type": "array", "maxItems": 25000, "items": { "$ref": "#/$defs/documentRelationship" } }
      }
    },
    "documentRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "kind", "source", "target", "order", "elementIdentity"],
      "properties": {
        "identity": { "$ref": "#/$defs/relationship/properties/identity" },
        "kind": { "const": "messageFlow" },
        "source": { "$ref": "#/$defs/relationship/properties/source" },
        "target": { "$ref": "#/$defs/relationship/properties/target" },
        "order": { "$ref": "#/$defs/relationship/properties/order" },
        "elementIdentity": { "$ref": "#/$defs/element/properties/identity" },
        "condition": { "$ref": "#/$defs/relationship/properties/condition" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "supported", "limitations"],
      "properties": {
        "status": { "enum": ["full", "partial"] },
        "supported": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "diagnosticSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "element": { "type": "string" },
        "ref": { "type": "string" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "disposition"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "disposition": { "enum": ["partial", "unresolved"] },
        "source": { "$ref": "#/$defs/diagnosticSource" }
      }
    },
    "elementSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "element": { "type": "string" }
      }
    },
    "element": {
      "description": "BPMN semantic or retained layout element. Process projections retain local parent references and may repeat shared layout ancestors with stable identities. Optional documents contain canonical layout and document-owned semantics; their parent references resolve against the same-file document/process union, without assigning collaboration semantics to a process.",
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "kind", "namespace", "id", "type", "order", "attributes", "source"],
      "properties": {
        "identity": { "type": "string", "pattern": "^landscape-element:[a-f0-9]{64}$" },
        "kind": { "enum": ["bpmn", "opaqueExtension", "unsupported"] },
        "namespace": { "type": "string" },
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "parent": { "type": "string", "pattern": "^landscape-element:[a-f0-9]{64}$" },
        "attributes": { "type": "object", "additionalProperties": { "type": "string" } },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": { "text": { "type": "string" }, "language": { "type": "string" } }
        },
        "source": { "$ref": "#/$defs/elementSource" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "kind", "source", "target", "order"],
      "properties": {
        "identity": { "type": "string", "pattern": "^landscape-relationship:[a-f0-9]{64}$" },
        "kind": { "enum": ["sequenceFlow", "messageFlow", "association", "reference"] },
        "source": { "type": "string", "pattern": "^landscape-element:[a-f0-9]{64}$" },
        "target": { "type": "string", "pattern": "^landscape-element:[a-f0-9]{64}$" },
        "order": { "type": "integer", "minimum": 0 },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "text": { "type": "string" }, "language": { "type": "string" } }
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processIdentity", "path", "byteLength", "sha256", "contextTags", "phaseTags",
        "coverage", "diagnostics", "elements", "relationships"
      ],
      "properties": {
        "processIdentity": { "type": "string", "pattern": "^landscape-process:[a-f0-9]{64}$" },
        "path": { "type": "string", "minLength": 1 },
        "byteLength": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "processId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "proposalStatus": { "enum": ["draft", "proposed", "approved"] },
        "contextTags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "phaseTags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "coverage": { "$ref": "#/$defs/coverage" },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteLength", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "byteLength": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceBytesBase64": { "type": "string" }
      }
    },
    "navigatorBundleIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteLength", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "byteLength": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "navigator": {
      "description": "Known category fields are typed but optional; partial records, additive record metadata and safe unresolved file references remain valid.",
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "verified"],
      "properties": {
        "bundle": { "$ref": "#/$defs/navigatorBundleIdentity" },
        "verified": { "type": "boolean" },
        "catalogue": { "$ref": "#/$defs/navigatorCatalogue" },
        "elements": { "$ref": "#/$defs/navigatorElements" },
        "links": { "$ref": "#/$defs/navigatorLinks" },
        "events": { "$ref": "#/$defs/navigatorEvents" },
        "lifecycle": { "$ref": "#/$defs/navigatorLifecycle" },
        "journey": { "$ref": "#/$defs/navigatorJourney" },
        "contexts": { "$ref": "#/$defs/navigatorContexts" },
        "procFile": { "type": "object", "additionalProperties": { "$ref": "#/$defs/navigatorFile" } },
        "dmn": { "type": "object", "additionalProperties": { "type": "string" } },
        "phases": { "$ref": "#/$defs/navigatorPhases" },
        "generated": {}
      }
    },
    "navigatorFile": {
      "description": "Bundle-local file reference; need not name an admitted file. UTF-16 length is additionally checked by the producer/API.",
      "type": "string", "minLength": 1, "maxLength": 1024,
      "pattern": "^(?![\\s\\S]*[\\\\:\\u0000-\\u001f\\u007f-\\u009f])(?!(?:[^/]+/)*\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "navigatorStrings": { "type": "array", "items": { "type": "string" } },
    "navigatorEventTuple": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [{ "type": "string" }, { "type": "string" }, { "type": "string" }], "items": false
    },
    "navigatorFilePair": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{ "$ref": "#/$defs/navigatorFile" }, { "type": "string" }], "items": false
    },
    "navigatorFileTriple": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [{ "$ref": "#/$defs/navigatorFile" }, { "type": "string" }, { "type": "string" }], "items": false
    },
    "navigatorCatalogue": {
      "type": "array", "items": { "type": "object", "properties": {
        "pid": { "type": "string" }, "group": { "type": "string" }, "name": { "type": "string" },
        "phases": { "type": "string" }, "ctx": { "type": "string" }, "inc": { "type": "string" },
        "grain": { "type": "string" }, "proc": { "type": "string" }, "purpose": { "type": "string" },
        "file": { "$ref": "#/$defs/navigatorFile" }, "procs": { "$ref": "#/$defs/navigatorStrings" }
      } }
    },
    "navigatorElements": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/navigatorFile" },
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "object", "properties": {
        "t": { "type": "string" }, "n": { "type": "string" },
        "pr": { "type": ["string", "null"] }, "lane": { "type": ["string", "null"] },
        "st": { "type": ["string", "null"] }, "src": { "type": ["string", "null"] },
        "dst": { "type": ["string", "null"] }, "msg": { "type": ["string", "null"] },
        "tgt": { "$ref": "#/$defs/navigatorFile" },
        "in": { "type": "array", "items": { "type": ["string", "null"] } },
        "out": { "type": "array", "items": { "type": ["string", "null"] } },
        "ev": { "type": "array", "items": { "$ref": "#/$defs/navigatorEventTuple" } }
      } } }
    },
    "navigatorLinks": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/navigatorFile" },
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "object", "properties": {
        "phase": { "type": "string" }, "ctx": { "type": "string" }, "ent": { "type": "string" },
        "ev": { "type": "string" }, "dmn": { "type": "string" }, "sf": { "type": "string" }, "inc": { "type": "string" }
      } } }
    },
    "navigatorEvents": {
      "type": "object", "additionalProperties": { "type": "object", "properties": {
        "ctx": { "type": "string" }, "kind": { "type": "string" }, "agg": { "type": "string" }, "phase": { "type": "string" },
        "throw": { "type": "array", "items": { "$ref": "#/$defs/navigatorFilePair" } },
        "catch": { "type": "array", "items": { "$ref": "#/$defs/navigatorFilePair" } },
        "ref": { "type": "array", "items": { "$ref": "#/$defs/navigatorFilePair" } }
      } }
    },
    "navigatorLifecycle": {
      "type": "array", "items": { "type": "object", "properties": {
        "name": { "type": "string" }, "entity": { "type": "string" }, "obj": { "type": "string" }, "ctx": { "type": "string" },
        "states": { "$ref": "#/$defs/navigatorStrings" },
        "tr": { "type": "array", "items": { "type": "object", "properties": {
          "f": { "type": "string" }, "t": { "type": "string" }, "cmd": { "type": "string" },
          "ev": { "type": "string" }, "guard": { "type": "string" }, "dmn": { "type": "string" }
        } } },
        "set": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/navigatorFileTriple" } } }
      } }
    },
    "navigatorJourney": {
      "type": "object", "properties": {
        "phases": { "type": "array", "items": { "type": "object", "properties": {
          "id": { "type": "string" }, "name": { "type": "string" }, "gate": { "type": "string" }, "purpose": { "type": "string" },
          "contexts": { "$ref": "#/$defs/navigatorStrings" },
          "files": { "type": "array", "items": { "$ref": "#/$defs/navigatorFile" } }
        } } },
        "entries": { "type": "array", "items": { "type": "object", "properties": {
          "name": { "type": "string" }, "text": { "type": "string" }, "file": { "$ref": "#/$defs/navigatorFile" }
        } } }
      }
    },
    "navigatorContexts": {
      "type": "array", "items": { "type": "object", "properties": {
        "id": { "type": "string" }, "name": { "type": "string" }, "cls": { "type": "string" }, "color": { "type": "string" }
      } }
    },
    "navigatorPhases": {
      "type": "array", "items": { "type": "object", "properties": {
        "id": { "type": "string" }, "name": { "type": "string" }, "gate": { "type": "string" }
      } }
    },
    "searchEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "kind", "processIdentity", "deepLink"],
      "properties": {
        "term": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["process", "element"] },
        "processIdentity": { "type": "string", "pattern": "^landscape-process:[a-f0-9]{64}$" },
        "elementIdentity": { "type": "string", "pattern": "^landscape-element:[a-f0-9]{64}$" },
        "deepLink": { "type": "string", "minLength": 1 }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processId", "resolved"],
      "properties": {
        "processId": { "type": "string", "minLength": 1 },
        "elementId": { "type": "string", "minLength": 1 },
        "processIdentity": { "type": "string", "pattern": "^landscape-process:[a-f0-9]{64}$" },
        "elementIdentity": { "type": "string", "pattern": "^landscape-element:[a-f0-9]{64}$" },
        "resolved": { "type": "boolean" }
      }
    },
    "crossProcessEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "source", "target"],
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/endpoint" },
        "target": { "$ref": "#/$defs/endpoint" }
      }
    },
    "lifecycleStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "order", "processId", "resolved"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "processId": { "type": "string", "minLength": 1 },
        "elementId": { "type": "string", "minLength": 1 },
        "processIdentity": { "type": "string", "pattern": "^landscape-process:[a-f0-9]{64}$" },
        "elementIdentity": { "type": "string", "pattern": "^landscape-element:[a-f0-9]{64}$" },
        "resolved": { "type": "boolean" }
      }
    },
    "objectLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectId", "stages"],
      "properties": {
        "objectId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "stages": { "type": "array", "items": { "$ref": "#/$defs/lifecycleStage" } }
      }
    },
    "journeyStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "processId", "resolved"],
      "properties": {
        "order": { "type": "integer", "minimum": 0 },
        "processId": { "type": "string", "minLength": 1 },
        "elementId": { "type": "string", "minLength": 1 },
        "processIdentity": { "type": "string", "pattern": "^landscape-process:[a-f0-9]{64}$" },
        "elementIdentity": { "type": "string", "pattern": "^landscape-element:[a-f0-9]{64}$" },
        "resolved": { "type": "boolean" }
      }
    },
    "phaseJourneyPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phaseId", "order", "steps"],
      "properties": {
        "phaseId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/journeyStep" } }
      }
    },
    "overlayEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "processIdentities"],
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "processIdentities": { "type": "array", "items": { "type": "string", "pattern": "^landscape-process:[a-f0-9]{64}$" } }
      }
    }
  }
}

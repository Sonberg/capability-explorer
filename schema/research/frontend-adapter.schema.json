{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capability-explorer/schema/research/frontend-adapter.contractDraft.v1.schema.json",
  "title": "Proposed language-neutral frontend adapter exchange",
  "description": "Research-only typed draft. Not ce.v1, not adopted, and not a semantic-quality claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "request", "result"],
  "properties": {
    "contract": { "const": "ce.frontend.contractDraft.v1" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSnapshot", "unit", "profileId", "requestedFeatures"],
      "properties": {
        "sourceSnapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositoryId", "revisionSha", "snapshotSha256"],
          "properties": {
            "repositoryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$" },
            "revisionSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "snapshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "unit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unitKey", "path", "name"],
          "properties": {
            "unitKey": { "type": "string", "minLength": 1, "maxLength": 512 },
            "path": { "type": "string", "pattern": "^(?:\\.|(?!/)(?!.*\\\\)(?!.*:)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*://)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\/$)[^\\x00]+)$" },
            "name": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "profileId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
        "requestedFeatures": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "languageProfileId", "features", "facts", "coverage", "status"],
      "properties": {
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "executableSha256", "configurationSha256"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 160 },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "executableSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "configurationSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "languageProfileId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "unsupported"],
          "properties": {
            "supported": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "unsupported": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["factId", "kind", "resolution", "evidence"],
            "properties": {
              "factId": { "type": "string", "minLength": 1, "maxLength": 256 },
              "kind": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
              "resolution": { "enum": ["resolved", "static-target", "candidate", "unresolved", "not-applicable"] },
              "targetFactId": { "type": "string", "minLength": 1, "maxLength": 256 },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sourceSha256", "startByte", "endByte", "byteOffsetEncoding"],
                  "properties": {
                    "path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*://)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\/$)[^\\x00]+$" },
                    "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "startByte": { "type": "integer", "minimum": 0 },
                    "endByte": { "type": "integer", "minimum": 0 },
                    "byteOffsetEncoding": { "const": "source-bytes" },
                    "position": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["encoding", "startLine", "startCharacter", "endLine", "endCharacter"],
                      "properties": {
                        "encoding": { "enum": ["utf-16-code-units", "utf-32-code-points"] },
                        "startLine": { "type": "integer", "minimum": 0 },
                        "startCharacter": { "type": "integer", "minimum": 0 },
                        "endLine": { "type": "integer", "minimum": 0 },
                        "endCharacter": { "type": "integer", "minimum": 0 }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filesTotal", "filesAnalyzed", "omittedPaths", "unresolvedFacts", "diagnostics"],
          "properties": {
            "filesTotal": { "type": "integer", "minimum": 0 },
            "filesAnalyzed": { "type": "integer", "minimum": 0 },
            "omittedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*://)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\/$)[^\\x00]+$" } },
            "unresolvedFacts": { "type": "integer", "minimum": 0 },
            "diagnostics": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "status": { "type": "string", "enum": ["complete", "partial", "unsupported", "failed"] }
      }
    }
  }
}

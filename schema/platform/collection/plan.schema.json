{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capability-explorer/schema/platform/collection/plan.schema.json",
  "title": "Offline collection plan",
  "description": "Local instructions only. These declarations do not authenticate enrollment, producer identity, tenant scope, or content rights.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "recipeSha256", "configSha256", "policySha256", "repositories", "inputs"],
  "properties": {
    "schema": { "const": "ce.collection.plan.v1" },
    "recipeSha256": { "$ref": "#/$defs/sha256" },
    "configSha256": { "$ref": "#/$defs/sha256" },
    "policySha256": { "$ref": "#/$defs/sha256" },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/repository" }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/input" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "repositoryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[/]$)[^\\\\:\\u0000-\\u001f\\u007f]+$",
      "description": "Literal relative path. The collector also rejects symlinks and verifies physical containment."
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "providerId", "producerId", "tenantRef", "rightsRef", "commitSha", "treeSha", "permittedContentProfiles"],
      "properties": {
        "repositoryId": { "$ref": "#/$defs/repositoryId" },
        "providerId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "producerId": { "$ref": "#/$defs/id" },
        "tenantRef": { "$ref": "#/$defs/id" },
        "rightsRef": { "$ref": "#/$defs/id" },
        "commitSha": { "$ref": "#/$defs/commit" },
        "treeSha": { "$ref": "#/$defs/commit" },
        "permittedContentProfiles": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "profile", "path", "unitPath", "sha256", "byteLength", "required"],
      "properties": {
        "repositoryId": { "$ref": "#/$defs/repositoryId" },
        "profile": { "type": "string", "minLength": 1, "maxLength": 128 },
        "path": { "$ref": "#/$defs/path" },
        "unitPath": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "required": { "type": "boolean" },
        "contentProfile": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    }
  }
}

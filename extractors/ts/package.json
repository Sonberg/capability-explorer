{
  "name": "@capability-explorer/ts-extractor",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript/JavaScript extractor. Stage 1: shared ce.v1 contract validation only.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "bin": { "ce-ts": "./src/cli.ts" },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "validate": "node src/cli.ts validate"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}

#!/usr/bin/env bash
# One trusted host coordinator owns the journal and all analysis effects.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"
source "$root/scripts/lib/container-engine.sh"
ce_engine_choice
[[ $# -le 1 ]] || { echo 'usage: scripts/analyze-worker [capabilities.json]' >&2; exit 2; }
command -v dotnet >/dev/null || { echo 'analysis worker requires the trusted host .NET 10 runtime; see docs/local-analysis-lifecycle.md' >&2; exit 2; }
cli="$root/platform/src/CapabilityExplorer.Cli/bin/Debug/net10.0/ce.dll"
[[ -f "$cli" ]] || { echo 'Build the project before starting the worker (make build).' >&2; exit 2; }
CE_CONTAINER_ENGINE="$CE_ENGINE" exec dotnet "$cli" analysis-worker --capabilities "${1:-capabilities.json}"

#!/usr/bin/env bash
# Analyses one capability: locks its repositories' revisions, exports those trees, runs the extractors and
# writes artifacts to .sandbox-cache/artifacts/<repo>/<commit>/, where a running `make explore` picks them up.
#
#   scripts/analyze <capability-id> [capabilities.json]
#
# Untrusted repository handling runs in separate sandboxes with only what each stage needs:
#   1 export    network (GitHub fetch) + GitHub token + read-only mounts of local repositories
#   2 packages  network for package downloads only (feeds from nuget.config); resolves one exact version set per
#               project into <work>/locks/<repo>.json; no GitHub token, no local repositories mounted
#   3 extract   --offline: the analysed code is parsed, never restored, built or executed
#   4 store     optional host-side step, only when CE_DATABASE (an Npgsql connection string) is set: migrate, import the
#               validated artifacts, embed them when a model is configured and, with BINDINGS=<file>, save bindings.
#
# Step 3 runs the C# (Roslyn), TypeScript/JavaScript and SQL extractors.
# Knobs: GITHUB_AUTH=auto|git|none (see scripts/github-token), LOCKED=1 analyses the last check instead of
# re-checking the refs, BINDINGS=bindings.json binds @unbound hints when storing, PACKAGES=0 skips the package download,
# INCLUDE_TESTS=1 includes test projects and test source files (excluded from the production graph by default)
# ANALYZE_JOBS=2 limits concurrent offline extraction jobs across all repositories and languages.
# (fewer resolved symbols, fully offline after 1).
# Private NuGet/npm feeds can be configured in Explorer Settings. NuGet credentials may also use %VAR% references
# in nuget.config with variable names listed in NUGET_PASS_ENV=VAR1,VAR2. Feed credentials are only passed to step 2.
# npm dependencies install only from lockfiles, with lifecycle scripts disabled.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"
source "$root/scripts/lib/container-engine.sh"
ce_require_docker 'complete analysis pipeline'
cap="${1:-}"; capabilities="${2:-capabilities.json}"
[[ "$cap" =~ ^[a-z0-9][a-z0-9._-]{0,99}$ ]] || { echo "usage: make analyze CAPABILITY=<id>   (ids are in $capabilities)" >&2; exit 2; }
jobs="${ANALYZE_JOBS:-2}"
[[ "$jobs" =~ ^[1-9][0-9]{0,3}$ ]] || { echo "ANALYZE_JOBS must be an integer from 1 to 9999" >&2; exit 2; }
phase_started=$SECONDS
phase_done() {
  echo "-- timing: $1 $((SECONDS - phase_started))s"
  phase_started=$SECONDS
}

work=".sandbox-cache/analyze/$cap"
artifacts=".sandbox-cache/artifacts"
packages=".sandbox-cache/analyze-packages"
ce="platform/src/CapabilityExplorer.Cli/bin/Debug/net10.0/ce.dll"
cs="platform/src/CapabilityExplorer.Extractors.CSharp/bin/Debug/net10.0/ce-cs.dll"
locks="$work/locks"   # one lock per repository: <repo>.json, project paths relative to that repository
ts="extractors/ts/src/cli.ts"
mkdir -p "$artifacts" "$packages"

echo "== 1/3 export locked revisions of '$cap'"
GITHUB_TOKEN="$(scripts/github-token "${GITHUB_AUTH:-auto}")" CE_HOST_HOME="$HOME" \
SANDBOX_PASS_ENV="${SANDBOX_PASS_ENV:+$SANDBOX_PASS_ENV,}GITHUB_TOKEN,CE_HOST_HOME" \
SANDBOX_SOURCES="$(scripts/capability-sources "$capabilities")" \
  scripts/sandbox dotnet dotnet "$ce" export --capability "$cap" --capabilities "$capabilities" \
    --workspace .sandbox-cache/sources --out "$work" ${LOCKED:+--locked 1}
  phase_done export

include_tests_setting="${INCLUDE_TESTS:-$(cat "$work/include-tests" 2>/dev/null || echo 0)}"
[[ "$include_tests_setting" == 0 || "$include_tests_setting" == 1 ]] || { echo "INCLUDE_TESTS must be 0 or 1" >&2; exit 2; }
include_tests=""; [[ "$include_tests_setting" == 1 ]] && include_tests="--include-tests"

if [[ "${PACKAGES:-1}" != 0 ]]; then
  package_feeds_file="${CE_PACKAGE_FEEDS_FILE:-.sandbox-cache/package-feeds/settings.json}"
  package_feeds='{"feeds":[]}'; [[ -f "$package_feeds_file" ]] && package_feeds="$(cat "$package_feeds_file")"

  echo "== 2/3 fetch referenced NuGet packages (data only: nuspec + reference assemblies)"
  rm -rf "$locks"; mkdir -p "$locks"
  CE_PACKAGE_FEEDS="$package_feeds" SANDBOX_PASS_ENV="CE_PACKAGE_FEEDS,CE_NUGET_ALLOWED_ORIGINS${NUGET_PASS_ENV:+,$NUGET_PASS_ENV}" SANDBOX_SOURCES="" scripts/sandbox dotnet bash -c '
    set -euo pipefail
    while IFS=$'"'"'\t'"'"' read -r repo sha path; do
      dotnet "$1" fetch-packages --source "$2/$path" --packages "$3" --lock "$4/$repo.json" ${5:+$5} </dev/null | sed "s#^#  $repo  #"
    done < "$2/manifest.tsv"' _ "$cs" "$work" "$packages" "$locks" "$include_tests"
  phase_done nuget
else
  rm -rf "$locks"
fi

if [[ "${PACKAGES:-1}" != 0 && -f "$ts" ]] && grep -q '"extract"' "$ts"; then
  echo "== fetch npm dependencies from lockfiles (lifecycle scripts disabled)"
  npm_feeds="$(CE_PACKAGE_FEEDS="$package_feeds" node scripts/fetch-npm-packages.mjs --resolve-host-feeds)"
  CE_PACKAGE_FEEDS="$npm_feeds" SANDBOX_PASS_ENV="CE_PACKAGE_FEEDS" SANDBOX_SOURCES="" scripts/sandbox node node scripts/fetch-npm-packages.mjs "$work/manifest.tsv"
  phase_done npm
fi

echo "== 3/3 extract (offline: C#, TypeScript/JavaScript, SQL)"
# Fresh output per revision, swapped in only when every extractor finished, so the explorer never sees half a set.
staging="$work/out"
rm -rf "$staging"; mkdir -p "$staging"
while IFS=$'\t' read -r repo sha path; do mkdir -p "$staging/$repo/$sha"; done < "$work/manifest.tsv"

extractors=(cs)
if [[ -f "$ts" ]] && grep -q '"extract"' "$ts"; then extractors+=(ts); fi
if [[ -f "$ts" ]] && grep -q '"extract-sql"' "$ts"; then extractors+=(sql); fi
active=0
pids=()
run_label="ce-extraction=$cap-$$"
engine="$CE_ENGINE"
stop_extraction() {
  local child containers
  for child in ${pids[@]+"${pids[@]}"}; do kill -TERM "$child" 2>/dev/null || true; done
  containers="$("$engine" ps -q --filter "label=$run_label" 2>/dev/null)" || containers=""
  if [[ -n "$containers" ]]; then "$engine" kill $containers >/dev/null 2>&1 || true; fi
  for child in ${pids[@]+"${pids[@]}"}; do wait "$child" 2>/dev/null || true; done
}
trap 'stop_extraction' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
reap_extraction() {
  local slot child code reaped
  while true; do
    reaped=0
    for slot in "${!pids[@]}"; do
      child="${pids[$slot]}"
      if ! kill -0 "$child" 2>/dev/null; then
        code=0; wait "$child" || code=$?
        unset 'pids[slot]'
        active=$((active - 1))
        if [[ "$code" != 0 ]]; then echo "-- extraction failed ($code); not publishing" >&2; exit "$code"; fi
        reaped=1
      fi
    done
    if [[ "$reaped" == 1 || "${1:-}" == ready ]]; then return; fi
    sleep 0.1
  done
}
echo "-- extraction concurrency: $jobs"
for extractor in "${extractors[@]}"; do
  while IFS=$'\t' read -r repo sha path; do
    if [[ "$active" -gt 0 ]]; then reap_extraction ready; fi
    while [[ "$active" -ge "$jobs" ]]; do reap_extraction; done
    output="$staging/tasks/$extractor/$repo/$sha"
    mkdir -p "$output"
    profile=node; command=(node "$ts" extract)
    case "$extractor" in
      cs) profile=dotnet; command=(dotnet "$cs" extract);;
      sql) command=(node "$ts" extract-sql);;
    esac
    command+=(--source "$work/$path" --repository "$repo" --commit "$sha" --out "$output")
    if [[ "$extractor" == cs && -d "$locks" ]]; then
      command+=(--packages "$packages")
      if [[ -f "$locks/$repo.json" ]]; then command+=(--lock "$locks/$repo.json"); fi
    fi
    if [[ "$extractor" != sql && -n "$include_tests" ]]; then command+=("$include_tests"); fi
    SANDBOX_LABEL="${SANDBOX_LABEL:-$run_label}" SANDBOX_EXTRA_LABEL="$run_label" SANDBOX_PASS_ENV="" SANDBOX_SOURCES="" \
      scripts/sandbox --offline "$profile" bash -c '
        set -euo pipefail
        prefix="$1"; shift
        started=$SECONDS
        "$@" 2>&1 | sed "s#^#  $prefix  #"
        echo "-- timing: $prefix $((SECONDS - started))s"
      ' _ "$repo $extractor" "${command[@]}" </dev/null &
    pids+=($!)
    active=$((active + 1))
  done < "$work/manifest.tsv"
done
while [[ "$active" -gt 0 ]]; do reap_extraction; done
trap - EXIT INT TERM
phase_done extraction
for extractor in "${extractors[@]}"; do
  while IFS=$'\t' read -r repo sha path; do
    cp -R "$staging/tasks/$extractor/$repo/$sha/." "$staging/$repo/$sha/"
  done < "$work/manifest.tsv"
done

count=0
imported=()
while IFS=$'\t' read -r repo sha path; do
  dest="$artifacts/$repo/$sha"
  rm -rf "$dest.old"; [[ -d "$dest" ]] && mv "$dest" "$dest.old"
  mkdir -p "$artifacts/$repo"; mv "$staging/$repo/$sha" "$dest"; rm -rf "$dest.old"
  count=$((count + $(find "$dest" -name '*.jsonl' | wc -l)))
  while IFS= read -r f; do imported+=("$f"); done < <(find "$dest" -name '*.jsonl' | sort)
done < "$work/manifest.tsv"
while IFS=$'\t' read -r repo sha path; do
  rm -rf "$work/$path"
  rmdir "$(dirname "$work/$path")" 2>/dev/null || true
done < "$work/manifest.tsv"
rm -rf "$staging"
phase_done promotion

if [[ -n "${CE_DATABASE:-}" ]]; then
  echo "== 4/4 import into PostgreSQL (CE_DATABASE)"
  # Import runs on the host after validation; analysed repository code is never loaded or executed here.
  # Embeddings use `make ollama`, the explorer's Settings page, or CE_MODEL_ENDPOINT + CE_EMBEDDING_MODEL.
  embed=0; [[ -n "${CE_MODEL_ENDPOINT:-}" || -f .sandbox-cache/model.json ]] && embed=1
  store_command() {
    if [[ "${CE_STORE_SANDBOX:-0}" == 1 ]]; then
      SANDBOX_PASS_ENV="CE_DATABASE,CE_MODEL_ENDPOINT,CE_EMBEDDING_MODEL" SANDBOX_SOURCES="" scripts/sandbox dotnet dotnet "$ce" "$@"
    else
      dotnet "$ce" "$@"
    fi
  }
  store_command migrate
  if [[ -n "${BINDINGS:-}" ]]; then store_command publish --scope "$cap" --bindings "$BINDINGS" "${imported[@]}"; else store_command publish --scope "$cap" "${imported[@]}"; fi
  phase_done publication
  if [[ "$embed" == 1 ]]; then store_command embed || echo "-- embeddings not updated (see above); run ce embed again later"; fi
  if [[ "$embed" == 1 ]]; then phase_done embeddings; fi
else
  echo "-- not storing: set CE_DATABASE=<Npgsql connection string> to import into PostgreSQL (BINDINGS=bindings.json to bind)"
fi

echo "== $count artifact(s) in $artifacts — a running 'make explore' reloads them automatically"

#!/usr/bin/env bash
# Trusted local coordinator; extraction children cannot publish.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"
source "$root/scripts/lib/container-engine.sh"
ce_engine_choice
[[ $# -ge 1 && $# -le 2 ]] || { echo 'usage: scripts/analyze <capability-id> [capabilities.json]' >&2; exit 2; }
command -v dotnet >/dev/null || { echo 'analysis requires the trusted host .NET 10 runtime; see docs/local-analysis-lifecycle.md' >&2; exit 2; }
cli="$root/platform/src/CapabilityExplorer.Cli/bin/Debug/net10.0/ce.dll"
[[ -f "$cli" ]] || { echo 'Build the project before starting analysis (make build).' >&2; exit 2; }
CE_CONTAINER_ENGINE="$CE_ENGINE" exec dotnet "$cli" analysis-run --capability "$1" --capabilities "${2:-capabilities.json}"

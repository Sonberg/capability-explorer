#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
source "$root/scripts/lib/container-engine.sh"
[[ $# -gt 0 ]] || { echo 'usage: scripts/container-engine <engine arguments...>' >&2; exit 2; }
ce_engine_init
if [[ "$1" == --analysis-snapshot ]]; then
	[[ $# -eq 1 ]] || { ce_runtime_fail '--analysis-snapshot does not accept engine arguments'; exit 2; }
	ce_analysis_snapshot
	exit
fi
ce_engine_exec "$@"
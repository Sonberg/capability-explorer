#!/usr/bin/env bash
# Prints, comma-separated, the local repository directories named in a capabilities file that exist on this
# machine, with ~ expanded. `make explore` mounts them read-only so the sandboxed explorer can read them.
# Relative paths need no mount: they resolve inside this checkout, which is always mounted.
set -uo pipefail
file="${1:-capabilities.json}"
[[ -f "$file" ]] || exit 0
out=()
# The file is written one property per line, so a line match is enough; GitHub URLs are skipped.
while IFS= read -r location; do
  case "$location" in
    https://*|http://*) continue ;;
    "~") path="$HOME" ;;
    "~/"*) path="$HOME/${location#\~/}" ;;
    /*) path="$location" ;;
    *) continue ;;
  esac
  [[ -d "$path" ]] && out+=("$path")
done < <(sed -n 's/^[[:space:]]*"location":[[:space:]]*"\(.*\)",\{0,1\}[[:space:]]*$/\1/p' "$file")
(IFS=,; printf '%s' "${out[*]:-}")

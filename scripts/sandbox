#!/usr/bin/env bash
# Runs a command inside a disposable container. All builds, installs and tests go through here;
# nothing is restored, installed or compiled on the host.
#
#   scripts/sandbox [options] <profile> <command...>
#
# Profiles:
#   dotnet   .NET SDK image (also has git)
#   node     Node.js image (also has git)
#
# Options:
#   --offline   no network at all (--network none). Use for steps that must not fetch anything.
#   --port N    publish container port N on the host's 127.0.0.1:N only (for the explorer UI).
#   --docker    mount the Docker socket so Testcontainers can start Postgres.
#   --package-settings   allow the local Explorer UI to read/write package feed settings.
#               This grants the container control of the host Docker daemon. Only test targets use it;
#               analysis/extraction steps must never get it.
#
# Hardening applied to every run:
#   - runs as the invoking host uid:gid, never root
#   - read-only root filesystem, all capabilities dropped, no-new-privileges
#   - only the repository is mounted (at /work); caches live in /work/.sandbox-cache
#   - environment is an explicit allowlist: no host variables or credentials leak in
#   - npm lifecycle scripts are disabled (npm_config_ignore_scripts=true)
#
# Environment knobs (host side):
#   SANDBOX_EXTRA_CA_FILE  extra CA bundle to trust (e.g. a TLS-intercepting egress proxy)
#   SANDBOX_NETWORK        docker network to use when not --offline (default: bridge)
#   SANDBOX_SOURCES        comma-separated absolute host paths (local repositories for capabilities) to mount
#                          read-only at the same path inside the container.
#   SANDBOX_LABEL          optional docker label (key=value) on the container, so a caller can find and stop it
#   SANDBOX_EXTRA_LABEL    additional label for cleanup of a nested group of containers
#   SANDBOX_PASS_ENV       comma-separated host variables to forward, e.g. CE_FOUNDRY_API_KEY.
#                          Nothing is forwarded unless named here; ignored with --offline.
#   SANDBOX_DOTNET_IMAGE / SANDBOX_NODE_IMAGE   override images
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
source "$root/scripts/lib/container-engine.sh"
ce_engine_choice
offline=0
docker_sock=0
package_settings=0
port=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --offline) offline=1; shift ;;
    --docker) docker_sock=1; shift ;;
      --package-settings) package_settings=1; shift ;;
    --port) port="$2"; shift 2 ;;
    -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
    *) break ;;
  esac
done
[[ $# -ge 2 ]] || { echo "usage: scripts/sandbox [--offline] [--docker] [--port N] <dotnet|node> <command...>" >&2; exit 2; }
profile="$1"; shift

if [[ "$CE_ENGINE" == podman && $docker_sock -eq 1 ]]; then
  ce_runtime_fail 'Podman socket/Testcontainers mode is not qualified in the core profile'; exit 2
fi
ce_engine_init

source "$root/config/runtime/images.env"
case "$profile" in
  dotnet) image="${SANDBOX_DOTNET_IMAGE:-$DOTNET_IMAGE}" ;;
  node)   image="${SANDBOX_NODE_IMAGE:-$NODE_IMAGE}" ;;
  *) echo "unknown profile: $profile" >&2; exit 2 ;;
esac
image="$(ce_image_ref "$image")"

cache="$root/.sandbox-cache"
mkdir -p "$cache/nuget" "$cache/nuget-http" "$cache/npm" "$cache/package-feeds"

args=(
  run --rm
  --user "$(id -u):$(id -g)"
  --read-only
  --tmpfs /tmp:rw,exec,nosuid,size=4g
  --cap-drop ALL
  --security-opt no-new-privileges
  --pids-limit 4096
  -v "$root:/work"
  -w /work
  -e HOME=/tmp/home
  -e CI=1
  -e DOTNET_CLI_TELEMETRY_OPTOUT=1
  -e DOTNET_NOLOGO=1
  -e DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
  -e DOTNET_CLI_HOME=/tmp/home
  -e NUGET_PACKAGES=/work/.sandbox-cache/nuget
  -e NUGET_HTTP_CACHE_PATH=/work/.sandbox-cache/nuget-http
  -e NUGET_XMLDOC_MODE=skip
  -e npm_config_cache=/work/.sandbox-cache/npm
  -e npm_config_ignore_scripts=true
  -e npm_config_fund=false
  -e npm_config_audit=false
  -e npm_config_update_notifier=false
  # Repository is mounted from the host; owner may differ from the container user.
  -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0='*'
)
[[ "$CE_ENGINE" != podman ]] || args+=(--userns keep-id)
if [[ $package_settings -eq 0 ]]; then
  args+=(--tmpfs /work/.sandbox-cache/package-feeds:rw,noexec,nosuid,size=1m)
fi
[[ -t 0 && -t 1 ]] && args+=(-it)

if [[ $offline -eq 1 ]]; then
  args+=(--network none)
elif [[ "$CE_ENGINE" == docker ]]; then
  # Services on the host (PostgreSQL, Ollama) are host.docker.internal, also on Linux where Docker does not add it.
  args+=(--network "${SANDBOX_NETWORK:-bridge}" --add-host host.docker.internal:host-gateway)
elif [[ -n "${SANDBOX_NETWORK:-}" ]]; then
  ce_runtime_fail 'custom Podman networks are not qualified in the core profile'; exit 2
fi

if [[ -n "$port" ]]; then
  [[ $offline -eq 0 ]] || { echo "--port cannot be combined with --offline" >&2; exit 2; }
  [[ "$port" =~ ^[0-9]+$ ]] || { echo "--port needs a number" >&2; exit 2; }
  args+=(-p "127.0.0.1:$port:$port" -e ASPNETCORE_URLS="http://0.0.0.0:$port")
fi

if [[ -n "${SANDBOX_SOURCES:-}" ]]; then
  IFS=',' read -ra sources <<<"$SANDBOX_SOURCES"
  mounted=","   # bash 3.2 compatible (macOS): no associative arrays
  for src in "${sources[@]}"; do
    [[ -z "$src" || "$mounted" == *",$src,"* ]] && continue
    [[ "$src" == /* && -d "$src" ]] || { echo "SANDBOX_SOURCES: '$src' must be an existing absolute directory" >&2; exit 2; }
    mounted+="$src,"
    args+=(-v "$src:$src:ro")
  done
fi

if [[ -n "${SANDBOX_PASS_ENV:-}" && $offline -eq 0 ]]; then
  IFS=',' read -ra pass <<<"$SANDBOX_PASS_ENV"
  for name in "${pass[@]}"; do
    [[ "$name" =~ ^[A-Z_][A-Z0-9_]*$ ]] || { echo "SANDBOX_PASS_ENV: invalid variable name '$name'" >&2; exit 2; }
    [[ -n "${!name:-}" ]] && args+=(-e "$name")
  done
fi

if [[ -n "${SANDBOX_EXTRA_CA_FILE:-}" ]]; then
  [[ -f "$SANDBOX_EXTRA_CA_FILE" ]] || { echo "SANDBOX_EXTRA_CA_FILE not found: $SANDBOX_EXTRA_CA_FILE" >&2; exit 2; }
  args+=(-v "$SANDBOX_EXTRA_CA_FILE:/etc/sandbox/extra-ca.crt:ro" -e NODE_EXTRA_CA_CERTS=/etc/sandbox/extra-ca.crt)
fi

if [[ $docker_sock -eq 1 ]]; then
  sock=/var/run/docker.sock
  [[ -S $sock ]] || { echo "--docker: $sock not found (is the Docker daemon running?)" >&2; exit 2; }
  args+=(
    -v "$sock:$sock"
    --group-add "$(stat -c %g "$sock")"
    # Testcontainers publishes container ports on the host; reach them via the host gateway.
    --add-host host.docker.internal:host-gateway
    -e TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal
    -e TESTCONTAINERS_RYUK_CONTAINER_IMAGE="$RYUK_IMAGE"
    -e DOCKER_HOST="unix://$sock"
  )
fi

# A label lets a caller find and stop its containers (scripts/analyze-worker: Stop in the explorer).
[[ -n "${SANDBOX_LABEL:-}" ]] && args+=(--label "$SANDBOX_LABEL")
[[ -n "${SANDBOX_EXTRA_LABEL:-}" ]] && args+=(--label "$SANDBOX_EXTRA_LABEL")

# Entry: build a combined CA bundle without root (system roots + extra CA), then exec the command.
entry='set -e
mkdir -p "$HOME"
if [ -f /etc/sandbox/extra-ca.crt ]; then
  cat /etc/ssl/certs/ca-certificates.crt /etc/sandbox/extra-ca.crt > /tmp/ca-bundle.pem
  export SSL_CERT_FILE=/tmp/ca-bundle.pem
  export GIT_SSL_CAINFO=/tmp/ca-bundle.pem
fi
exec "$@"'

ce_engine_exec "${args[@]}" "$image" sh -c "$entry" sandbox "$@"

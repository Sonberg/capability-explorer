#!/usr/bin/env bash
# Verify the approved local gate covers exact source and current main target.
set -euo pipefail
fail() { echo "pr-check: $*" >&2; exit 1; }
[[ $# -eq 0 ]] || fail 'usage: scripts/pr-check'
entry_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source "$entry_root/scripts/lib/source-context.sh"
root="$(ce_source_context_root "$entry_root")" || exit 1
cd "$root"
[[ "$(git symbolic-ref --quiet --short HEAD || true)" != main ]] ||
  fail 'work on a feature branch targeting main; do not work directly on main'
clean() {
  local state
  state="$(git status --porcelain --untracked-files=all)" || return 1
  [[ -z "$state" ]]
}
clean || fail 'working tree must be clean'
cache="$root/.sandbox-cache/local-ci"
mkdir -p "$cache"
lock="$cache/run.lock"
mkdir "$lock" 2>/dev/null || fail 'another local CI or PR check is running'
trap 'rmdir "$lock" 2>/dev/null || true' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
head="$(git rev-parse --verify HEAD)"
base="$(scripts/check-target-alignment)"
receipt=.sandbox-cache/local-ci/last-success.txt
[[ -f "$receipt" ]] || fail 'no successful local CI receipt; run the full local gate'
evidence="$(cat "$receipt")"
[[ "$(printf '%s\n' "$evidence" | sed -n 's/^target=//p')" == main ]] || fail 'receipt target does not match main; rerun the full local gate'
[[ "$(printf '%s\n' "$evidence" | sed -n 's/^head=//p')" == "$head" ]] || fail 'receipt does not match HEAD; rerun the full local gate'
[[ "$(printf '%s\n' "$evidence" | sed -n 's/^base=//p')" == "$base" ]] || fail 'target branch changed since CI; integrate it and rerun the full local gate'
mode="$(python3 scripts/ci/docs-check.py mode "$base" "$head")"
recorded_mode="$(printf '%s\n' "$evidence" | sed -n 's/^mode=//p')"
[[ "${recorded_mode:-full}" == "$mode" ]] || fail 'receipt CI profile does not match the current diff'
if [[ "$mode" == full ]]; then
  source "$root/scripts/lib/container-engine.sh"
  ce_require_docker 'full local CI receipt verification'
elif [[ "$mode" != docs ]]; then
  fail 'unknown CI profile'
fi
[[ "$(git rev-parse --verify HEAD)" == "$head" ]] && clean || fail 'source changed during PR preparation'
echo "pr-check: verified HEAD $head against main $base"

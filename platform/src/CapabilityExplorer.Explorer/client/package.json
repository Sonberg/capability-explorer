{
  "name": "@capability-explorer/explorer-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:graph-connections": "tsc --ignoreConfig --noEmit --module nodenext --moduleResolution nodenext --target es2023 --types node --skipLibCheck test/architecture-connections.browser.ts && node --test --experimental-strip-types test/architecture-connections.browser.ts",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@hpcc-js/wasm-graphviz": "1.29.2",
    "@likec4/core": "1.60.0",
    "@xyflow/react": "12.12.0",
    "bpmn-js": "18.31.1",
    "dmn-js": "18.0.1",
    "likec4": "1.60.0",
    "lucide-react": "1.68.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}

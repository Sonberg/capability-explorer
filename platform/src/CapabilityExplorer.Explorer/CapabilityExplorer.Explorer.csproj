<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>ce-explorer</AssemblyName>
    <!-- Explorer serves JSON produced from repository content; keep it read-only and local. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CapabilityExplorer.Contracts/CapabilityExplorer.Contracts.csproj" />
    <ProjectReference Include="../CapabilityExplorer.Interpretation/CapabilityExplorer.Interpretation.csproj" />
    <ProjectReference Include="../CapabilityExplorer.Capabilities/CapabilityExplorer.Capabilities.csproj" />
    <ProjectReference Include="../CapabilityExplorer.Binding/CapabilityExplorer.Binding.csproj" />
    <ProjectReference Include="../CapabilityExplorer.Store/CapabilityExplorer.Store.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Keep Vite outputs independent: the legacy build empties source wwwroot. -->
    <Content Remove="client-next/**" />
    <Content Include="client-next/dist/**"
             Link="wwwroot/process-landscape/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- API builds/tests stay frontend-independent; deployment must include the navigator. -->
  <Target Name="ValidateExplorerFrontendAssets" BeforeTargets="PrepareForPublish"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/client-next/dist/index.html')"
           Text="Process landscape assets are missing. Integrate client-next, then run make ui-process-landscape before publishing." />
    <Error Condition="Exists('$(MSBuildProjectDirectory)/wwwroot/process-landscape')"
           Text="Remove stale source wwwroot/process-landscape. Only client-next/dist owns the nested SPA; do not stage it inside legacy wwwroot." />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="glossary-weights.json" LogicalName="glossary-weights.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CapabilityExplorer.Explorer.Tests" />
  </ItemGroup>
</Project>

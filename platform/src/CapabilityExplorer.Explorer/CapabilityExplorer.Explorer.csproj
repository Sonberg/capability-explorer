<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>ce-explorer</AssemblyName>
    <!-- Explorer serves JSON produced from repository content; keep it read-only and local. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CapabilityExplorer.Contracts/CapabilityExplorer.Contracts.csproj" />
    <ProjectReference Include="../CapabilityExplorer.Interpretation/CapabilityExplorer.Interpretation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CapabilityExplorer.Explorer.Tests" />
  </ItemGroup>
</Project>

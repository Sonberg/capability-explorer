      },
      {
        "relation": "CONSUMES"
      },
      {
        "relation": "READS"
      },
      {
        "relation": "WRITES"
      },
      {
        "relation": "MAPS_TO",
        "fromKinds": [
          "Type"
        ]
      }
    ],
    "exhaustiveNodeKinds": [
      "Endpoint",
      "Channel"
    ]
  },
  "thresholds": {
    "nodeRecall": 1.0,
    "edgeRecall": 1.0,
    "edgeAccuracy": 1.0,
    "evidenceLocated": 1.0,
